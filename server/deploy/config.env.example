# Copy to /etc/archerypal/config.env on RPIserver (chmod 640).

# Local only — nginx proxies public HTTPS to the Incus guest via :18081.

LISTEN_ADDR=127.0.0.1:8080



# Set to production on deployed servers (enforces JWT_SECRET guard).

ENV=production



# WebSocket URLs returned by POST /v1/matches/challenge.

PUBLIC_WS_BASE=wss://universeconflict.duckdns.org



DB_PATH=/var/lib/archerypal/archerypal.db

JWT_SECRET=generate-a-long-random-secret-here

MAX_ROOMS=32

ROOM_TTL_MINUTES=30

MIGRATIONS_DIR=/opt/archerypal/migrations



# Required for POST /v1/admin/* (shoot sync, beta invites)

ADMIN_API_KEY=generate-a-long-random-admin-key-here



# Optional: Google Sign-In account restore (Android OAuth client ID)

# GOOGLE_OAUTH_CLIENT_ID=



# Optional: require invite code on POST /v1/players/register

# REQUIRE_BETA_INVITE=true



# Testing only — never on production (server refuses to start if ENV=production)

# BYPASS_PLUS_ENTITLEMENT=true

# ALLOW_UNVERIFIED_ENTITLEMENT_SYNC=true



# Trust X-Forwarded-For from nginx (enable only behind a reverse proxy)

TRUST_FORWARDED_FOR=true



# Phase 4 — Google Play server verification (see docs/GOOGLE_PLAY_SERVER_VERIFY.md)

# GOOGLE_PLAY_PACKAGE_NAME=com.archerypal.app

# GOOGLE_PLAY_SA_PATH=/etc/archerypal/google-play-sa.json



# FCM push invites (Firebase service account JSON on the server — see docs/FCM_SETUP.md)

# FCM_CREDENTIALS_PATH=/etc/archerypal/firebase-adminsdk.json

