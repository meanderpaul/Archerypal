# Copy to `.dev.vars` for local `wrangler dev` only. Never put these on production.
BYPASS_PLUS_ENTITLEMENT=true
ALLOW_UNVERIFIED_ENTITLEMENT_SYNC=true
JWT_SECRET=dev-jwt-secret-change-me
GOOGLE_OAUTH_CLIENT_ID=
REVENUECAT_WEBHOOK_SECRET=
ADMIN_API_KEY=
